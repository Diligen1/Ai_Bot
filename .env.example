BINANCE_API_KEY=
BINANCE_API_SECRET=
OPENAI_API_KEY=
TESTNET=true

# AI Analyzer V1 (advisory only, virtual/paper trading — see ai/analyzer.py).
# Disabled by default even if a key is set below; must be explicitly enabled.
AI_ENABLED=false
GEMINI_API_KEY=

# Live Execution Engine V2 (execution/live_trading_engine.py) — REAL Binance
# orders. Defaults to false (and MUST be treated as false if this line is
# absent). Change only manually, only when you intend real trades; there is
# no Dashboard toggle for this on purpose.
LIVE_TRADING_ENABLED=false

# Live Trading Runtime (execution/live_trading_runtime.py) — how often (in
# seconds) the automated multi-symbol cycle re-reads the whitelist and
# re-checks every symbol. Runs regardless of LIVE_TRADING_ENABLED (the
# cycle itself is read-only unless that flag is also true); default 20.
LIVE_ENGINE_INTERVAL_SECONDS=20
